# Names and placeholders only (Annex J J.5.1). When the platform runs from
# barber-saas-infra-postgres, these same names live in its env/dev.env; this copy is for running
# MongoDB alone (scripts/up.sh dev). Copy to env/dev.env, which git ignores, and fill it in.
COMPOSE_PROJECT_NAME=barber-saas-dev

# Single MongoDB instance (ADR-011). The administrator is used only by the infrastructure and by
# the -db migration runners; services connect as <domain>_app.
MONGO_ADMIN_USER=barbersaas_admin
MONGO_ADMIN_PASSWORD=
# Shared secret of the replica set (any long random string, e.g. openssl rand -base64 48).
MONGO_REPLICA_KEY=

# One password per domain user, created by mongo/01-instance.js
NOTIFICATIONS_APP_PASSWORD=
